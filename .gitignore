# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# pytest 临时目录（跑测试时创建，由于权限问题可能残留）
pytest-tmp/
pytest-tmp-*/

# Runtime output — these are regenerable, never commit them
output/
.cache/
*.sqlite3

# Local config overrides (may contain machine-specific or credentialed settings)
configs/local.yaml

# Media
*.mp4
*.mov
*.mkv
*.wav
*.jpg
*.png
!tests/fixtures/**/*.png

# Bundled ffmpeg binaries (see tools/README.md).
# The binaries themselves are ~100 MB each and must not enter version control;
# scripts/get_ffmpeg.py re-fetches them for a fresh checkout.
tools/ffmpeg
tools/ffmpeg.exe
tools/ffprobe
tools/ffprobe.exe
tools/*.zip

# Editors
.vscode/
.idea/
*.swp
.DS_Store
